#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command_name=${1:-}
if [ -z "$command_name" ]; then
  printf '%s\n' 'usage: source-structure-check {baseline|check|require-zero} [options]' >&2
  exit 2
fi
shift
case "$command_name" in
  baseline|check|require-zero)
    exec "$script_dir/$command_name" "$@"
    ;;
  *)
    printf 'unknown source-structure-check command: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
