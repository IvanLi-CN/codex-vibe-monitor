{
  "name": "codex-vibe-monitor-hooks",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check:bun-first": "bash .github/scripts/check-bun-first.sh",
    "check:source-quality": "bash scripts/check-source-quality.sh",
    "check:source-quality:staged": "bash scripts/check-staged-source-quality.sh",
    "hooks:install": "bash scripts/install-lefthook-hooks.sh",
    "lint:docs": "biome check docs-site",
    "lint:web": "biome check web",
    "typecheck:web": "cd web && bunx tsc -b",
    "verify:rust": "cargo fmt --all -- --check && cargo clippy --locked --all-targets --all-features -- -D warnings -D clippy::too_many_arguments -A clippy::too_many_lines -A clippy::excessive_nesting",
    "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
    "worktree:setup": "bash scripts/worktree-setup.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "commitlint-plugin-function-rules": "^4.1.0",
    "dprint": "^0.47.5",
    "lefthook": "^2.1.7"
  }
}
