#!/usr/bin/env python3
"""Run runtime integration on the testbox; performance acceptance is Actions-only."""
import argparse
import datetime as dt
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--testbox", default="codex-testbox")
    parser.add_argument("--candidate", default="HEAD")
    parser.add_argument("--samply", required=True, help="verified remote samply 0.13.1 path under /srv/codex")
    parser.add_argument("--reuse-image", help="candidate-revision-bound image already on the testbox")
    parser.add_argument("--seconds", type=int, default=300)
    parser.add_argument("--rate", type=int, default=5)
    args = parser.parse_args()
    agent = os.environ.get("CODEX_THREAD_ID", "")
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", agent):
        parser.error("CODEX_THREAD_ID must be a canonical Agent Directory identity")
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", args.testbox):
        parser.error("invalid testbox alias")
    if not Path(args.samply).is_relative_to("/srv/codex") or ".." in Path(args.samply).parts:
        parser.error("samply must be installed under /srv/codex")
    candidate = subprocess.check_output(["git", "rev-parse", "--verify", args.candidate + "^{commit}"], text=True).strip()
    if not re.fullmatch(r"[a-f0-9]{40}", candidate):
        parser.error("candidate must resolve to a commit")
    run = f"/srv/codex/agents/{agent}/acceptance-{dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{candidate[:8]}"
    source = run + "/source"
    # Shell text is constructed only from validated identities and individually quoted arguments.
    destination = "mkdir -p " + shlex.quote(source) + " && tar -xf - -C " + shlex.quote(source)
    archive = subprocess.Popen(["git", "archive", "--format=tar", candidate], stdout=subprocess.PIPE)
    try:
        subprocess.run(["ssh", args.testbox, destination], stdin=archive.stdout, check=True)
    finally:
        archive.stdout.close()
    if archive.wait() != 0:
        raise RuntimeError("candidate source transfer failed")
    command = ["python3", source + "/scripts/observability-acceptance/run.py", "--source", source,
               "--run", run + "/runtime", "--agent", agent, "--candidate", candidate, "--samply", args.samply,
               "--seconds", str(args.seconds), "--rate", str(args.rate),
               "--environment", "shared-testbox", "--suite", "runtime"]
    if args.reuse_image: command += ["--image", args.reuse_image]
    print("Evidence locator: " + args.testbox + ":" + run + "/runtime", flush=True)
    return subprocess.call(["ssh", args.testbox, shlex.join(command)])


if __name__ == "__main__":
    sys.exit(main())
