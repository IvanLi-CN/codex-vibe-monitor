#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/shared-testbox-performance-acceptance [options]

Run the independent performance telemetry acceptance workload on codex-testbox.

Options:
  --testbox HOST       SSH host alias (default: codex-testbox)
  --reuse-image TAG    Skip docker build and reuse an existing image tag
  --service-code-sha SHA  Commit SHA of the code inside a reused baseline image
  --compat-image TAG  Older application image used for a read-compatibility smoke
  --scenario NAME      overhead, sustained, long-wait, prompt-cache-control, prompt-cache-checkpoint, or capacity (default: sustained)
  --mode NAME          baseline or candidate for prompt-cache control/checkpoint (default: candidate)
  --duration SECONDS   Sustained round duration (default: 300)
  --rounds COUNT       Sustained round count (default: 3)
  --rate COUNT         Proxy requests per second (default: 50)
  --mock-delay-ms MS   Override mock upstream response delay for sustained runs
  --warmup-seconds SECONDS  Wait after health before measured rounds (default: 0)
  --capture-p1-ack     Sample System Status P1 ACK snapshots every 10 seconds
  --cleanup             Remove this run directory and a newly-built image
  PERFORMANCE_TELEMETRY_ENABLED=true|false  Toggle telemetry for the run
  CODEX_THREAD_ID      Agent Directory identifier for the testbox run
USAGE
}

TESTBOX="codex-testbox"
REUSE_IMAGE_TAG=""
SERVICE_CODE_SHA=""
COMPAT_IMAGE_TAG=""
SCENARIO="sustained"
PROMPT_CACHE_CONTROL_MODE="candidate"
DURATION_SECONDS=300
ROUNDS=3
REQUEST_RATE=50
MOCK_UPSTREAM_DELAY_MS=""
WARMUP_SECONDS=0
CAPTURE_P1_ACK=0
REQUEST_RATE_SET=0
MOCK_DELAY_SET=0
CLEANUP=0
PERFORMANCE_TELEMETRY_ENABLED="${PERFORMANCE_TELEMETRY_ENABLED:-true}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --testbox)
      TESTBOX="$2"
      shift 2
      ;;
    --reuse-image)
      REUSE_IMAGE_TAG="$2"
      shift 2
      ;;
    --service-code-sha)
      SERVICE_CODE_SHA="$2"
      shift 2
      ;;
    --compat-image)
      COMPAT_IMAGE_TAG="$2"
      shift 2
      ;;
    --scenario)
      SCENARIO="$2"
      shift 2
      ;;
    --mode)
      PROMPT_CACHE_CONTROL_MODE="$2"
      shift 2
      ;;
    --duration)
      DURATION_SECONDS="$2"
      shift 2
      ;;
    --rounds)
      ROUNDS="$2"
      shift 2
      ;;
    --rate)
      REQUEST_RATE="$2"
      REQUEST_RATE_SET=1
      shift 2
      ;;
    --mock-delay-ms)
      MOCK_UPSTREAM_DELAY_MS="$2"
      MOCK_DELAY_SET=1
      shift 2
      ;;
    --warmup-seconds)
      WARMUP_SECONDS="$2"
      shift 2
      ;;
    --capture-p1-ack)
      CAPTURE_P1_ACK=1
      shift
      ;;
    --cleanup)
      CLEANUP=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ "$SCENARIO" = "overhead" ]; then
  if [ "$REQUEST_RATE_SET" -eq 0 ]; then
    REQUEST_RATE=10
  fi
  if [ "$MOCK_DELAY_SET" -eq 0 ]; then
    MOCK_UPSTREAM_DELAY_MS=50
  fi
fi
if [[ "$SCENARIO" = "prompt-cache-control" || "$SCENARIO" = "prompt-cache-checkpoint" ]] && [ "$REQUEST_RATE_SET" -eq 0 ]; then
  REQUEST_RATE=4
fi

case "$SCENARIO" in
  overhead|sustained|long-wait|prompt-cache-control|prompt-cache-checkpoint|capacity) ;;
  *) echo "--scenario must be overhead, sustained, long-wait, prompt-cache-control, prompt-cache-checkpoint, or capacity" >&2; exit 2 ;;
esac
if [[ "$SCENARIO" = "prompt-cache-control" || "$SCENARIO" = "prompt-cache-checkpoint" ]]; then
  case "$PROMPT_CACHE_CONTROL_MODE" in
    baseline|candidate) ;;
    *) echo '--mode must be baseline or candidate for prompt-cache-control' >&2; exit 2 ;;
  esac
elif [ "$PROMPT_CACHE_CONTROL_MODE" != "candidate" ]; then
  echo '--mode is only supported with a prompt-cache scenario' >&2
  exit 2
fi
if [ "$SCENARIO" = "prompt-cache-control" ] && [ "$PROMPT_CACHE_CONTROL_MODE" = "candidate" ]; then
  if [ "$DURATION_SECONDS" -ne 300 ] || [ "$ROUNDS" -ne 3 ] || [ "$REQUEST_RATE" -ne 4 ]; then
    echo 'candidate prompt-cache-control requires --duration 300 --rounds 3 --rate 4' >&2
    exit 2
  fi
fi
if [ "$SCENARIO" = "prompt-cache-checkpoint" ]; then
  expected_rounds=3
  if [ "$PROMPT_CACHE_CONTROL_MODE" = "baseline" ]; then expected_rounds=1; fi
  if [ "$DURATION_SECONDS" -ne 600 ] || [ "$ROUNDS" -ne "$expected_rounds" ] || [ "$REQUEST_RATE" -ne 4 ]; then
    echo 'prompt-cache-checkpoint requires --duration 600 --rate 4 and baseline --rounds 1 or candidate --rounds 3' >&2
    exit 2
  fi
  if [ "$MOCK_DELAY_SET" -eq 0 ]; then MOCK_UPSTREAM_DELAY_MS=50; fi
  if [ "$PROMPT_CACHE_CONTROL_MODE" = "candidate" ] && [ -z "$COMPAT_IMAGE_TAG" ]; then
    echo 'prompt-cache-checkpoint candidate requires --compat-image for the older-reader check' >&2
    exit 2
  fi
fi
if ! [[ "$DURATION_SECONDS" =~ ^[0-9]+$ && "$DURATION_SECONDS" -ge 1 ]]; then
  echo '--duration must be a positive integer' >&2
  exit 2
fi
if ! [[ "$ROUNDS" =~ ^[0-9]+$ && "$ROUNDS" -ge 1 ]]; then
  echo '--rounds must be a positive integer' >&2
  exit 2
fi
if ! [[ "$REQUEST_RATE" =~ ^[0-9]+$ && "$REQUEST_RATE" -ge 1 ]]; then
  echo '--rate must be a positive integer' >&2
  exit 2
fi
if [ -n "$MOCK_UPSTREAM_DELAY_MS" ] && ! [[ "$MOCK_UPSTREAM_DELAY_MS" =~ ^[0-9]+$ ]]; then
  echo '--mock-delay-ms must be a non-negative integer' >&2
  exit 2
fi
if ! [[ "$WARMUP_SECONDS" =~ ^[0-9]+$ ]]; then
  echo '--warmup-seconds must be a non-negative integer' >&2
  exit 2
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo 'current directory must be inside a Git worktree' >&2
  exit 64
}
REPO_ROOT="$(python3 - <<'PY' "$REPO_ROOT"
import os, sys
print(os.path.realpath(sys.argv[1]))
PY
)"
REPO_NAME="$(basename "$REPO_ROOT")"
PATH_HASH8="$(python3 - <<'PY' "$REPO_ROOT"
import hashlib, os, sys
print(hashlib.sha256(os.path.realpath(sys.argv[1]).encode()).hexdigest()[:8])
PY
)"
AGENT_ID="${CODEX_THREAD_ID:-}"
if [[ ! "$AGENT_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo 'CODEX_THREAD_ID must be a safe non-empty testbox agent identifier' >&2
  exit 64
fi
if git -C "$REPO_ROOT" ls-files -s | awk '$1 == "160000" { found=1 } END { exit !found }'; then
  echo 'submodules must be transferred directly; sync helper only supports ordinary worktrees' >&2
  exit 64
fi
GIT_SHA="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo nogit)"
if [ -z "$SERVICE_CODE_SHA" ]; then SERVICE_CODE_SHA="$GIT_SHA"; fi
RUN_ID="$(date +%Y%m%d_%H%M%S)_performance_${GIT_SHA:0:12}_$$"
WORKSPACE_SLUG="${REPO_NAME}__${PATH_HASH8}"
REMOTE_AGENT="/srv/codex/agents/${AGENT_ID}"
REMOTE_RUN="${REMOTE_AGENT}/runs/${RUN_ID}"
REMOTE_WORKSPACE="${REMOTE_RUN}/workspace"
COMPOSE_PROJECT_RAW="codex_${WORKSPACE_SLUG}_${RUN_ID}"
COMPOSE_PROJECT="$(python3 - <<'PY' "$COMPOSE_PROJECT_RAW"
import hashlib, re, sys
value = re.sub(r'[^a-z0-9_-]+', '_', sys.argv[1].lower()).strip('_')
suffix = hashlib.sha256(sys.argv[1].encode()).hexdigest()[:10]
prefix = value[:52].rstrip('_')
print(f'{prefix}_{suffix}')
PY
)"
IMAGE_TAG="${REUSE_IMAGE_TAG}"
if [ -z "$IMAGE_TAG" ]; then
  IMAGE_TAG_RAW="codex_${WORKSPACE_SLUG}_${RUN_ID}"
  IMAGE_TAG="$(python3 - <<'PY' "$IMAGE_TAG_RAW"
import re, sys
value = re.sub(r'[^a-z0-9_.-]+', '_', sys.argv[1].lower()).strip('._-')
print(value[:120])
PY
)"
fi

printf '== local repo ==\n%s\n' "$REPO_ROOT"
printf '== remote run ==\n%s\n' "$REMOTE_RUN"
printf '== image tag ==\n%s\n' "$IMAGE_TAG"
printf '== compose project ==\n%s\n' "$COMPOSE_PROJECT"
printf '== workload ==\nscenario=%s mode=%s rate=%s mock_delay_ms=%s warmup_seconds=%s capture_p1_ack=%s\n' "$SCENARIO" "$PROMPT_CACHE_CONTROL_MODE" "$REQUEST_RATE" "${MOCK_UPSTREAM_DELAY_MS:-default}" "$WARMUP_SECONDS" "$CAPTURE_P1_ACK"

ssh -o BatchMode=yes "$TESTBOX" bash -s -- "$AGENT_ID" "$REMOTE_WORKSPACE" "$REMOTE_RUN" <<'REMOTE'
set -euo pipefail
agent_id="$1"
workspace="$2"
run_dir="$3"
base=/srv/codex/agents
agent_dir="$base/$agent_id"
run_parent="$agent_dir/runs"
[[ -d "$base" && ! -L "$base" ]]
if [[ -e "$agent_dir" || -L "$agent_dir" ]]; then
  [[ -d "$agent_dir" && ! -L "$agent_dir" ]]
else
  mkdir -- "$agent_dir"
fi
[[ "$(readlink -f -- "$agent_dir")" == "$agent_dir" ]]
if [[ -e "$run_parent" || -L "$run_parent" ]]; then
  [[ -d "$run_parent" && ! -L "$run_parent" ]]
else
  mkdir -- "$run_parent"
fi
[[ "$(readlink -f -- "$run_parent")" == "$run_parent" ]]
case "$run_dir" in
  "$run_parent"/*) ;;
  *) exit 64 ;;
esac
[[ ! -e "$run_dir" && ! -L "$run_dir" ]]
mkdir -- "$run_dir"
[[ -d "$run_dir" && ! -L "$run_dir" ]]
[[ "$(readlink -f -- "$run_dir")" == "$run_dir" ]]
[[ "$workspace" == "$run_dir/workspace" ]]
mkdir -- "$workspace"
[[ "$(readlink -f -- "$workspace")" == "$workspace" ]]
REMOTE

rsync -az --from0 --files-from=- \
  "$REPO_ROOT/" "$TESTBOX:$REMOTE_WORKSPACE/" < <(
  git -C "$REPO_ROOT" ls-files -co --exclude-standard -z |
    while IFS= read -r -d '' path; do
      if [[ -e "$REPO_ROOT/$path" || -L "$REPO_ROOT/$path" ]]; then
        printf '%s\0' "$path"
      fi
    done
)

ssh -o BatchMode=yes "$TESTBOX" env \
  REMOTE_WORKSPACE="$REMOTE_WORKSPACE" \
  REMOTE_RUN="$REMOTE_RUN" \
  IMAGE_TAG="$IMAGE_TAG" \
  REUSE_IMAGE_TAG="$REUSE_IMAGE_TAG" \
  PERFORMANCE_TELEMETRY_ENABLED="$PERFORMANCE_TELEMETRY_ENABLED" \
  SCENARIO="$SCENARIO" \
  DURATION_SECONDS="$DURATION_SECONDS" \
  ROUNDS="$ROUNDS" \
  REQUEST_RATE="$REQUEST_RATE" \
  MOCK_UPSTREAM_DELAY_MS="$MOCK_UPSTREAM_DELAY_MS" \
  WARMUP_SECONDS="$WARMUP_SECONDS" \
  PROMPT_CACHE_CONTROL_MODE="$PROMPT_CACHE_CONTROL_MODE" \
  CAPTURE_P1_ACK="$CAPTURE_P1_ACK" \
  CLEANUP="$CLEANUP" \
  COMPOSE_PROJECT="$COMPOSE_PROJECT" \
  GIT_SHA="$GIT_SHA" \
  SERVICE_CODE_SHA="$SERVICE_CODE_SHA" \
  COMPAT_IMAGE_TAG="$COMPAT_IMAGE_TAG" \
  bash -s <<'REMOTE'
set -euo pipefail
export TZ=Asia/Shanghai

COMPOSE_FILE="$REMOTE_RUN/.codex-performance.compose.yaml"
CAPS_OVERRIDE="$REMOTE_RUN/.codex.caps-compat.yaml"
MOCK_SCRIPT="$REMOTE_RUN/.codex-performance-mock.py"
LOADGEN_SCRIPT="$REMOTE_RUN/.codex-performance-loadgen.py"
CONTROL_LOADGEN_SCRIPT="$REMOTE_WORKSPACE/scripts/prompt-cache-control-loadgen.py"
CHECKPOINT_LOADGEN_SCRIPT="$REMOTE_WORKSPACE/scripts/prompt-cache-checkpoint-loadgen.py"
RANGE_LOADGEN_SCRIPT="$REMOTE_WORKSPACE/scripts/invocation-range-acceptance.py"
BASE_COMPOSE_FILE="$REMOTE_RUN/.codex-performance.compose.base.yaml"
OLD_READER_OVERRIDE="$REMOTE_RUN/.codex-old-reader.compose.yaml"
DATA_DIR="$REMOTE_RUN/data"
LOG_DIR="$REMOTE_RUN/logs"
LOAD_LOG="$LOG_DIR/loadgen.jsonl"
STATS_LOG="$LOG_DIR/container-stats.jsonl"
TOKEN="pool-shared-testbox-key"
ACCOUNT_KEY="upstream-primary-key"
DIRECT_PROXY_KEY="__direct__"
ENCRYPTION_SECRET="shared-testbox-encryption-secret"
stats_pid=""
app_logs_pid=""
LIVE_APP_LOG="$LOG_DIR/prompt-cache-pressure-live.log"
APP_RUST_LOG=warn
if [[ "$SCENARIO" = "prompt-cache-control" || "$SCENARIO" = "prompt-cache-checkpoint" ]]; then
  APP_RUST_LOG=info
fi
if [[ "$SCENARIO" = "long-wait" || "$SCENARIO" = "prompt-cache-control" || "$SCENARIO" = "prompt-cache-checkpoint" ]]; then
  APP_RUST_LOG="$APP_RUST_LOG,codex_vibe_monitor::prompt_cache_conversations::invocation_ranges=debug"
fi

mkdir -p "$DATA_DIR" "$LOG_DIR"
chmod 0777 "$DATA_DIR"
python3 - <<'PY' "$LOG_DIR/run-metadata.json"
import hashlib
import json
import os
import pathlib
import sys
from datetime import datetime, timezone

scenario_sources = [
    pathlib.Path(os.environ["REMOTE_WORKSPACE"]) / "scripts" / name
    for name in ("shared-testbox-performance-acceptance", "prompt-cache-control-loadgen.py", "prompt-cache-checkpoint-loadgen.py", "invocation-range-acceptance.py")
]
scenario_digest = hashlib.sha256(b"".join(path.read_bytes() for path in scenario_sources)).hexdigest()
metadata = {
    'harness_sha': os.environ.get('GIT_SHA'),
    'service_code_sha': os.environ.get('SERVICE_CODE_SHA'),
    'scenario_digest': scenario_digest,
    'testbox_run_dir': os.environ.get('REMOTE_RUN'),
    'service_image': os.environ.get('IMAGE_TAG'),
    'compatibility_image': os.environ.get('COMPAT_IMAGE_TAG') or None,
    'scenario': os.environ.get('SCENARIO'),
    'mode': os.environ.get('PROMPT_CACHE_CONTROL_MODE'),
    'duration_seconds': int(os.environ.get('DURATION_SECONDS', '0')),
    'rounds': int(os.environ.get('ROUNDS', '0')),
    'request_rate': int(os.environ.get('REQUEST_RATE', '0')),
    'mock_upstream_delay_ms': os.environ.get('MOCK_UPSTREAM_DELAY_MS') or 'default',
    'started_at_utc': datetime.now(timezone.utc).isoformat(timespec='seconds'),
}
with open(sys.argv[1], 'w', encoding='utf-8') as destination:
    json.dump(metadata, destination, indent=2)
    destination.write('\n')
PY

stop_prompt_cache_log_reader() {
  if [ -n "$app_logs_pid" ]; then
    kill "$app_logs_pid" >/dev/null 2>&1 || true
    wait "$app_logs_pid" >/dev/null 2>&1 || true
    app_logs_pid=""
  fi
}

start_prompt_cache_log_reader() {
  docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" -f "$CAPS_OVERRIDE" \
    logs --follow --no-color app >> "$LIVE_APP_LOG" 2>&1 &
  app_logs_pid=$!
}

cleanup_remote() {
  set +e
  stop_prompt_cache_log_reader
  if [ -n "$stats_pid" ]; then
    kill "$stats_pid" >/dev/null 2>&1 || true
    wait "$stats_pid" >/dev/null 2>&1 || true
    stats_pid=""
  fi
  if [ -f "$COMPOSE_FILE" ]; then
    if [[ "$SCENARIO" = "prompt-cache-control" || "$SCENARIO" = "prompt-cache-checkpoint" ]] && [ -d "$LOG_DIR" ]; then
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" -f "$CAPS_OVERRIDE" logs --no-color app \
        > "$LOG_DIR/app-on-exit.log" 2>/dev/null || true
    fi
    docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" -f "$CAPS_OVERRIDE" down --remove-orphans >/dev/null 2>&1 || true
  fi
  rm -f "$MOCK_SCRIPT" "$LOADGEN_SCRIPT" "$COMPOSE_FILE" "$CAPS_OVERRIDE" "$BASE_COMPOSE_FILE"
  rm -f "$OLD_READER_OVERRIDE"
  if [ "$CLEANUP" = "1" ]; then
    run_parent="$(dirname "$REMOTE_RUN")"
    agent_dir="$(dirname "$run_parent")"
    if [ -L "$run_parent" ] || [ -L "$agent_dir" ] \
      || [ "$(readlink -f -- "$run_parent")" != "$run_parent" ] \
      || [ "$(readlink -f -- "$agent_dir")" != "$agent_dir" ] \
      || [ ! -d "$REMOTE_RUN" ] || [ -L "$REMOTE_RUN" ] \
      || [ "$(readlink -f -- "$REMOTE_RUN")" != "$REMOTE_RUN" ]; then
      echo "refusing cleanup outside the current Agent Directory run: $REMOTE_RUN" >&2
      return 1
    fi
    if [ -z "$REUSE_IMAGE_TAG" ]; then
      docker image rm -f "$IMAGE_TAG" >/dev/null 2>&1 || true
    fi
    rm -rf "$REMOTE_RUN"
  fi
}
trap cleanup_remote EXIT

cat > "$MOCK_SCRIPT" <<'PY'
#!/usr/bin/env python3
import json
import os
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

class Handler(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def log_message(self, fmt, *args):
        pass

    def do_POST(self):
        length = int(self.headers.get('Content-Length', '0') or '0')
        remaining = length
        body_bytes = bytearray()
        while remaining > 0:
            chunk = self.rfile.read(min(65536, remaining))
            if not chunk:
                break
            body_bytes.extend(chunk)
            remaining -= len(chunk)
        if self.path not in ('/v1/responses', '/v1/responses/compact'):
            body = json.dumps({'error': 'unsupported path'}).encode()
            self.send_response(404)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        override_delay_ms = os.environ.get('MOCK_UPSTREAM_DELAY_MS', '')
        try:
            payload = json.loads(bytes(body_bytes).decode() or '{}')
        except (UnicodeDecodeError, json.JSONDecodeError):
            payload = {}
        scenario_delay = {
            'slow-success': 179.0,
            'slow-timeout': 181.0,
            'cancel': 5.0,
            'fast': 0.05,
        }.get(payload.get('testScenario'))
        delay = (
            scenario_delay
            if scenario_delay is not None
            else float(override_delay_ms) / 1000.0
            if override_delay_ms
            else (1.2 if self.path == '/v1/responses' else 0.8)
        )
        body = json.dumps({'ok': True, 'path': self.path}).encode()
        if payload.get('testScenario') == 'cancel':
            try:
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                self.wfile.write(body[:1])
                self.wfile.flush()
                time.sleep(delay)
                self.wfile.write(body[1:])
                self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass
            return
        time.sleep(delay)
        try:
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass

server = ThreadingHTTPServer(('0.0.0.0', 18080), Handler)
server.serve_forever()
PY
chmod +x "$MOCK_SCRIPT"

cat > "$LOADGEN_SCRIPT" <<'PY'
#!/usr/bin/env python3
import base64
import http.client
import json
import math
import os
import queue
import socket
import sqlite3
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
import urllib.error
import urllib.parse
import urllib.request

BASE_URL = 'http://app:8080'
TOKEN = 'pool-shared-testbox-key'
ACCOUNT_KEY = 'upstream-primary-key'
DIRECT_PROXY_KEY = '__direct__'
DATA_DIR = '/work/data'
CAPTURE_P1_ACK = os.environ.get('CAPTURE_P1_ACK') == '1'


def request(method, path, payload=None, headers=None, timeout=30):
    data = None if payload is None else json.dumps(payload).encode()
    request_headers = {'Authorization': f'Bearer {TOKEN}'}
    if payload is not None:
        request_headers.update({'Content-Type': 'application/json', 'Content-Length': str(len(data))})
    request_headers.update(headers or {})
    req = urllib.request.Request(BASE_URL + path, data=data, method=method, headers=request_headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            body = response.read().decode(errors='replace')
            return response.status, body
    except urllib.error.HTTPError as error:
        return error.code, error.read().decode(errors='replace')


def wait_health():
    deadline = time.time() + 120
    last_error = None
    while time.time() < deadline:
        try:
            status, body = request('GET', '/health', timeout=5)
            if status == 200 and body == 'ok':
                print(json.dumps({'phase': 'wait-health', 'status': 'ok'}), flush=True)
                return
            last_error = f'status={status} body={body[:200]}'
        except Exception as exc:
            last_error = str(exc)
        time.sleep(1)
    raise SystemExit(f'healthcheck timed out: {last_error}')


def seed():
    status, body = request('PUT', '/api/pool/routing-settings', {'apiKey': TOKEN})
    if status != 200:
        raise SystemExit(f'failed to seed pool routing settings: status={status} body={body[:500]}')
    status, body = request('POST', '/api/pool/upstream-accounts/api-keys', {
        'displayName': 'Shared Performance Primary',
        'apiKey': ACCOUNT_KEY,
        'boundProxyKeys': [DIRECT_PROXY_KEY],
        'upstreamBaseUrl': 'http://mock-upstream:18080/',
    })
    if status != 200:
        raise SystemExit(f'failed to create api-key account: status={status} body={body[:500]}')
    print(json.dumps({'phase': 'seed', 'status': 'ok'}), flush=True)


def percentile(values, fraction):
    if not values:
        return None
    ordered = sorted(values)
    index = min(len(ordered) - 1, max(0, math.ceil(len(ordered) * fraction) - 1))
    return round(ordered[index], 2)


def sse_path():
    descriptors = [{
        'topic': 'dashboard.activity.current',
        'params': {
            'range': 'today',
            'timeZone': 'Asia/Shanghai',
            'recentLimit': '16',
            'includeAccounts': 'true',
            'includeRecent': 'true',
        },
    }]
    encoded = base64.urlsafe_b64encode(json.dumps(descriptors, separators=(',', ':')).encode()).decode().rstrip('=')
    query = urllib.parse.urlencode({'topics': encoded, 'attempt': '1', 'reason': 'performance-acceptance'})
    return f'/events?{query}'


def sse_worker(stop_event, started_event, result):
    connection = None
    try:
        connection = http.client.HTTPConnection('app', 8080, timeout=10)
        connection.request('GET', sse_path(), headers={'Authorization': f'Bearer {TOKEN}', 'Accept': 'text/event-stream'})
        response = connection.getresponse()
        result['status'] = response.status
        if response.status != 200:
            result['error'] = response.read(400).decode(errors='replace')
            return
        result['connected'] = True
        started_event.set()
        try:
            response.fp.raw._sock.settimeout(1.0)
        except Exception:
            pass
        while not stop_event.is_set():
            try:
                response.fp.readline()
            except socket.timeout:
                continue
            except (OSError, ValueError):
                break
    except Exception as exc:
        result['error'] = str(exc)
        started_event.set()
    finally:
        if connection is not None:
            connection.close()


def proxy_once(sequence):
    path = '/v1/responses' if sequence % 2 == 0 else '/v1/responses/compact'
    payload = json.dumps({'model': 'gpt-5', 'input': f'performance-acceptance-{sequence}'})
    request_headers = {
        'Authorization': f'Bearer {TOKEN}',
        'Content-Type': 'application/json',
        'Content-Length': str(len(payload.encode())),
    }
    started = time.perf_counter()
    try:
        req = urllib.request.Request(BASE_URL + path, data=payload.encode(), method='POST', headers=request_headers)
        with urllib.request.urlopen(req, timeout=30) as response:
            body = response.read().decode(errors='replace')
            return response.status, (time.perf_counter() - started) * 1000, body[:200]
    except urllib.error.HTTPError as error:
        return error.code, (time.perf_counter() - started) * 1000, error.read().decode(errors='replace')[:200]
    except Exception as exc:
        return 'exception', (time.perf_counter() - started) * 1000, str(exc)[:200]


def long_wait_terminal_row(invoke_id):
    try:
        connection = sqlite3.connect(os.path.join(DATA_DIR, 'codex_vibe_monitor.db'), timeout=0.25)
        connection.execute('PRAGMA busy_timeout=250')
        row = connection.execute(
            'SELECT status, t_req_parse_ms, t_persist_ms, t_total_ms, t_upstream_ttfb_ms '
            'FROM codex_invocations WHERE invoke_id = ? ORDER BY id DESC LIMIT 1',
            (invoke_id,),
        ).fetchone()
        connection.close()
        return row
    except sqlite3.OperationalError:
        return None


def long_wait_terminal(invoke_id, response_finished):
    deadline = time.perf_counter() + 10.0
    while time.perf_counter() < deadline:
        row = long_wait_terminal_row(invoke_id)
        if row and str(row[0] or '').lower() not in ('running', 'pending', 'in_flight'):
            return {
                'status': row[0],
                'request_parse_ms': row[1],
                'persist_ms': row[2],
                'total_ms': row[3],
                'upstream_ttfb_ms': row[4],
                'confirm_ms': (time.perf_counter() - response_finished) * 1000,
            }
        time.sleep(0.01)
    return None


def cancel_attempt_by_key(prompt_cache_key):
    try:
        connection = sqlite3.connect(os.path.join(DATA_DIR, 'codex_vibe_monitor.db'), timeout=0.25)
        connection.execute('PRAGMA busy_timeout=250')
        row = connection.execute(
            'SELECT invoke_id, status, phase, failure_kind, error_message, downstream_error_message '
            'FROM pool_upstream_request_attempts WHERE sticky_key = ? ORDER BY id DESC LIMIT 1',
            (prompt_cache_key,),
        ).fetchone()
        connection.close()
        return row
    except sqlite3.OperationalError:
        return None


def cancel_attempt_by_id(invoke_id):
    try:
        connection = sqlite3.connect(os.path.join(DATA_DIR, 'codex_vibe_monitor.db'), timeout=0.25)
        connection.execute('PRAGMA busy_timeout=250')
        row = connection.execute(
            'SELECT status, phase, failure_kind, error_message, downstream_error_message '
            'FROM pool_upstream_request_attempts WHERE invoke_id = ? ORDER BY id DESC LIMIT 1',
            (invoke_id,),
        ).fetchone()
        connection.close()
        return row
    except sqlite3.OperationalError:
        return None


def cancel_invocation_by_id(invoke_id):
    try:
        connection = sqlite3.connect(os.path.join(DATA_DIR, 'codex_vibe_monitor.db'), timeout=0.25)
        connection.execute('PRAGMA busy_timeout=250')
        row = connection.execute(
            'SELECT status, failure_kind, failure_class, error_message '
            'FROM codex_invocations WHERE invoke_id = ? ORDER BY id DESC LIMIT 1',
            (invoke_id,),
        ).fetchone()
        connection.close()
        return row
    except sqlite3.OperationalError:
        return None


def wait_for_cancel_invocation(prompt_cache_key, timeout_seconds):
    deadline = time.perf_counter() + timeout_seconds
    while time.perf_counter() < deadline:
        row = cancel_attempt_by_key(prompt_cache_key)
        if row:
            return row
        time.sleep(0.01)
    return None


def wait_for_cancel_terminal(invoke_id, timeout_seconds):
    deadline = time.perf_counter() + timeout_seconds
    while time.perf_counter() < deadline:
        attempt = cancel_attempt_by_id(invoke_id)
        if attempt and (
            str(attempt[0] or '').lower() not in ('running', 'pending', 'in_flight')
            and str(attempt[1] or '').lower()
            not in (
                'running',
                'pending',
                'started',
                'in_flight',
                'active',
                'waiting',
                'streaming_response',
                'response_headers',
                'body_streaming',
            )
        ):
            invocation = cancel_invocation_by_id(invoke_id)
            invocation_status = str(invocation[0] or '').lower() if invocation else ''
            invocation_error = str(invocation[3] or '') if invocation else ''
            invocation_has_terminal_marker = invocation and (
                invocation[1] == 'downstream_closed'
                or invocation[2] == 'client_abort'
                or 'downstream_closed' in invocation_error
            )
            if (
                invocation
                and invocation_status not in ('', 'running', 'pending', 'in_flight')
                and invocation_has_terminal_marker
            ):
                return {
                    'attempt_status': attempt[0],
                    'attempt_phase': attempt[1],
                    'attempt_failure_kind': attempt[2],
                    'attempt_error_message': attempt[3],
                    'attempt_downstream_error_message': attempt[4],
                    'invocation_status': invocation[0],
                    'invocation_failure_kind': invocation[1],
                    'invocation_failure_class': invocation[2],
                    'invocation_error_message': invocation[3],
                }
        time.sleep(0.01)
    return None


def long_wait_proxy_once(spec, timeout_seconds):
    payload = {
        'model': 'gpt-5',
        'input': f"long-wait-{spec['round']}-{spec['sequence']}",
        'testScenario': spec['scenario'],
    }
    request_headers = {
        'Authorization': f'Bearer {TOKEN}',
        'Content-Type': 'application/json',
    }
    prompt_cache_key = spec.get('prompt_cache_key')
    if prompt_cache_key:
        payload['promptCacheKey'] = prompt_cache_key
        request_headers['x-prompt-cache-key'] = prompt_cache_key
    encoded = json.dumps(payload).encode()
    request_headers['Content-Length'] = str(len(encoded))
    started = time.perf_counter()
    status = 'exception'
    body = ''
    invoke_id = None
    response_finished = None
    try:
        req = urllib.request.Request(
            BASE_URL + '/v1/responses', data=encoded, method='POST', headers=request_headers
        )
        with urllib.request.urlopen(req, timeout=timeout_seconds) as response:
            body = response.read().decode(errors='replace')[:200]
            status = response.status
            invoke_id = response.headers.get('x-cvm-invoke-id')
            response_finished = time.perf_counter()
    except urllib.error.HTTPError as error:
        status = error.code
        body = error.read().decode(errors='replace')[:200]
        invoke_id = error.headers.get('x-cvm-invoke-id') if error.headers else None
        response_finished = time.perf_counter()
    except Exception as exc:
        body = str(exc)[:200]
        response_finished = time.perf_counter()
    terminal = (
        long_wait_terminal(invoke_id, response_finished)
        if invoke_id and spec.get('track_terminal', True)
        else None
    )
    return {
        'sequence': spec['sequence'],
        'scenario': spec['scenario'],
        'key_mode': spec['key_mode'],
        'status': status,
        'body': body,
        'invoke_id': invoke_id,
        'response_finished': response_finished,
        'response_ms': (response_finished - started) * 1000,
        'terminal': terminal,
    }


def long_wait_cancel(round_index):
    prompt_cache_key = f'cancel-{round_index}'
    payload = json.dumps({
        'model': 'gpt-5',
        'input': f'long-wait-cancel-{round_index}',
        'testScenario': 'cancel',
        'promptCacheKey': prompt_cache_key,
    }).encode()
    headers = (
        f'POST /v1/responses HTTP/1.1\r\n'
        f'Host: app:8080\r\n'
        f'Authorization: Bearer {TOKEN}\r\n'
        'Content-Type: application/json\r\n'
        f'Content-Length: {len(payload)}\r\n\r\n'
    ).encode()
    started = time.perf_counter()
    sock = None
    try:
        sock = socket.create_connection(('app', 8080), timeout=5)
        sock.sendall(headers + payload)
        accepted = wait_for_cancel_invocation(prompt_cache_key, 5)
        if accepted is None:
            sock.close()
            return {
                'status': 'client_closed',
                'duration_ms': (time.perf_counter() - started) * 1000,
                'server_accepted': False,
                'invoke_id': None,
                'terminal': None,
            }
        close_started = time.perf_counter()
        time.sleep(1.0)
        sock.close()
        close_duration_ms = (time.perf_counter() - close_started) * 1000
        terminal = wait_for_cancel_terminal(accepted[0], 15)
        return {
            'status': 'client_closed',
            'duration_ms': close_duration_ms,
            'server_accepted': True,
            'invoke_id': accepted[0],
            'terminal': terminal,
        }
    except Exception as exc:
        if sock is not None:
            sock.close()
        return {
            'status': 'exception',
            'error': str(exc),
            'duration_ms': (time.perf_counter() - started) * 1000,
            'server_accepted': False,
            'invoke_id': None,
            'terminal': None,
        }


def run_long_wait_round(round_index, duration_seconds, request_rate):
    slow_modes = [
        ('slow-success', 'same', 'slow-success-shared'),
        ('slow-success', 'same', 'slow-success-shared'),
        ('slow-success', 'different', f'slow-success-{round_index}-different'),
        ('slow-success', 'none', None),
        ('slow-timeout', 'same', 'slow-timeout-shared'),
        ('slow-timeout', 'same', 'slow-timeout-shared'),
        ('slow-timeout', 'different', f'slow-timeout-{round_index}-different'),
        ('slow-timeout', 'none', None),
    ]
    slow_specs = [
        {
            'round': round_index,
            'sequence': sequence,
            'scenario': scenario,
            'key_mode': key_mode,
            'prompt_cache_key': prompt_cache_key,
        }
        for sequence, (scenario, key_mode, prompt_cache_key) in enumerate(slow_modes)
    ]
    started_at = time.perf_counter()
    slow_pool = ThreadPoolExecutor(max_workers=8)
    slow_futures = [slow_pool.submit(long_wait_proxy_once, spec, 195) for spec in slow_specs]
    cancel_result = {}
    cancel_thread = threading.Thread(
        target=lambda: cancel_result.update(long_wait_cancel(round_index)), daemon=True
    )
    cancel_thread.start()

    fast_futures = []
    with ThreadPoolExecutor(max_workers=2) as fast_pool:
        next_request_at = started_at
        sequence = 0
        deadline = started_at + duration_seconds
        while time.perf_counter() < deadline:
            key_mode = ('same', 'different', 'none')[sequence % 3]
            prompt_cache_key = (
                'fast-shared'
                if key_mode == 'same'
                else f'fast-{round_index}-{sequence}'
                if key_mode == 'different'
                else None
            )
            fast_futures.append(fast_pool.submit(long_wait_proxy_once, {
                'round': round_index,
                'sequence': 1000 + sequence,
                'scenario': 'fast',
                'key_mode': key_mode,
                'prompt_cache_key': prompt_cache_key,
            }, 15))
            sequence += 1
            next_request_at += 1.0 / request_rate
            delay = next_request_at - time.perf_counter()
            if delay > 0:
                time.sleep(delay)
    fast_results = [future.result() for future in fast_futures]
    slow_results = [future.result() for future in slow_futures]
    slow_pool.shutdown(wait=True)
    cancel_thread.join(timeout=10)

    fast_bad = [
        item for item in fast_results
        if item['status'] != 200 or item['terminal'] is None
    ]
    fast_parse_ms = [
        item['terminal']['request_parse_ms']
        for item in fast_results
        if item['terminal'] and isinstance(item['terminal']['request_parse_ms'], (int, float))
    ]
    fast_confirm_ms = [
        item['terminal']['confirm_ms']
        for item in fast_results
        if item['terminal'] and isinstance(item['terminal']['confirm_ms'], (int, float))
    ]
    slow_success = [item for item in slow_results if item['scenario'] == 'slow-success']
    slow_timeout = [item for item in slow_results if item['scenario'] == 'slow-timeout']
    cancel_terminal = cancel_result.get('terminal') or {}
    cancel_ok = (
        cancel_result.get('status') == 'client_closed'
        and isinstance(cancel_result.get('duration_ms'), (int, float))
        and cancel_result['duration_ms'] <= 5000
        and cancel_result.get('server_accepted') is True
        and str(cancel_terminal.get('attempt_status') or '').lower()
        not in ('', 'running', 'pending', 'in_flight')
        and str(cancel_terminal.get('attempt_phase') or '').lower()
        not in (
            '',
            'running',
            'pending',
            'started',
            'in_flight',
            'active',
            'waiting',
            'streaming_response',
            'response_headers',
            'body_streaming',
        )
        and str(cancel_terminal.get('invocation_status') or '').lower()
        not in ('', 'running', 'pending', 'in_flight')
        and (
            cancel_terminal.get('invocation_failure_kind') == 'downstream_closed'
            or cancel_terminal.get('invocation_failure_class') == 'client_abort'
            or 'downstream_closed' in str(cancel_terminal.get('invocation_error_message') or '')
        )
        and (
            cancel_terminal.get('attempt_failure_kind') == 'downstream_closed'
            or cancel_terminal.get('invocation_failure_kind') == 'downstream_closed'
            or cancel_terminal.get('invocation_failure_class') == 'client_abort'
            or 'downstream_closed' in str(cancel_terminal.get('attempt_downstream_error_message') or '')
        )
    )
    success_ok = all(
        item['status'] == 200
        and item['terminal'] is not None
        and 170000 <= item['response_ms'] <= 185000
        for item in slow_success
    )
    timeout_ok = all(
        item['status'] != 200
        and item['terminal'] is not None
        and 175000 <= item['response_ms'] <= 195000
        for item in slow_timeout
    )
    summary = {
        'phase': 'long-wait-round',
        'round': round_index,
        'duration_seconds': duration_seconds,
        'request_rate': request_rate,
        'fast_submitted': len(fast_results),
        'fast_bad_count': len(fast_bad),
        'fast_bad_examples': fast_bad[:3],
        'allocation_parse_p99_ms': percentile(fast_parse_ms, 0.99),
        'terminal_confirm_p99_ms': percentile(fast_confirm_ms, 0.99),
        'slow_success_ok': success_ok,
        'slow_timeout_ok': timeout_ok,
        'cancel_ok': cancel_ok,
        'slow_results': slow_results,
        'cancel_result': cancel_result,
    }
    print(json.dumps(summary, ensure_ascii=False), flush=True)
    if (
        fast_bad
        or not fast_parse_ms
        or not fast_confirm_ms
        or not success_ok
        or not timeout_ok
        or not cancel_ok
        or summary['allocation_parse_p99_ms'] > 100
        or summary['terminal_confirm_p99_ms'] > 1000
    ):
        raise SystemExit(f'long-wait acceptance failed in round {round_index}')


def run_long_wait(duration_seconds, rounds, request_rate):
    seed()
    subprocess.run(['python', '/work/invocation-range-acceptance.py', 'install'], check=True)
    subprocess.run(['python', '/work/invocation-range-acceptance.py', 'probe'], check=True)
    for round_index in range(1, rounds + 1):
        run_long_wait_round(round_index, duration_seconds, request_rate)
    print(json.dumps({
        'phase': 'long-wait-complete',
        'rounds': rounds,
        'duration_seconds': duration_seconds,
        'request_rate': request_rate,
    }), flush=True)


def system_status_worker(stop_event, samples, errors):
    while not stop_event.is_set():
        try:
            status, body = request('GET', '/api/system/status', timeout=5)
            if status != 200:
                errors.append(status)
            else:
                payload = json.loads(body)
                value = (
                    payload.get('runtimePressureHealth', {})
                    .get('writerAccounting', {})
                    .get('p1AckDurationMs')
                )
                if isinstance(value, (int, float)) and math.isfinite(value):
                    samples.append(float(value))
        except (ValueError, TypeError, OSError, urllib.error.URLError) as exc:
            errors.append(type(exc).__name__)
        # Full status snapshots are intentionally low-frequency to avoid changing the workload.
        stop_event.wait(10.0)


def run_round(round_index, duration_seconds, request_rate, sse_count=16):
    stop_sse = threading.Event()
    sse_started = threading.Event()
    sse_results = [{} for _ in range(sse_count)]
    sse_threads = [
        threading.Thread(target=sse_worker, args=(stop_sse, sse_started, result), daemon=True)
        for result in sse_results
    ]
    for thread in sse_threads:
        thread.start()
    time.sleep(2)
    status_stop = threading.Event()
    p1_ack_samples = []
    status_errors = []
    status_thread = None
    if CAPTURE_P1_ACK:
        status_thread = threading.Thread(
            target=system_status_worker,
            args=(status_stop, p1_ack_samples, status_errors),
            daemon=True,
        )
        status_thread.start()

    work_queue = queue.Queue(maxsize=max(256, request_rate * 4))
    result_lock = threading.Lock()
    results = []
    producer_done = threading.Event()

    def worker():
        while True:
            try:
                sequence = work_queue.get(timeout=0.2)
            except queue.Empty:
                if producer_done.is_set():
                    return
                continue
            try:
                result = proxy_once(sequence)
                with result_lock:
                    results.append(result)
            finally:
                work_queue.task_done()

    workers = [threading.Thread(target=worker, daemon=True) for _ in range(max(80, request_rate * 2))]
    for thread in workers:
        thread.start()

    started_at = time.monotonic()
    deadline = started_at + duration_seconds
    next_request_at = started_at
    submitted = 0
    dropped_from_queue = 0
    while time.monotonic() < deadline:
        next_request_at += 1.0 / request_rate
        try:
            work_queue.put(submitted, timeout=1)
            submitted += 1
        except queue.Full:
            dropped_from_queue += 1
        delay = next_request_at - time.monotonic()
        if delay > 0:
            time.sleep(delay)
    producer_done.set()
    work_queue.join()
    for thread in workers:
        thread.join(timeout=2)
    if status_thread is not None:
        status_stop.set()
        status_thread.join(timeout=3)
    stop_sse.set()
    for thread in sse_threads:
        thread.join(timeout=3)

    durations = [item[1] for item in results]
    bad = [item for item in results if item[0] != 200]
    summary = {
        'phase': 'sustained-round',
        'round': round_index,
        'duration_seconds': duration_seconds,
        'request_rate': request_rate,
        'submitted': submitted,
        'completed': len(results),
        'queue_drops': dropped_from_queue,
        'bad_count': len(bad),
        'bad_examples': bad[:3],
        'sse_connected': sum(1 for item in sse_results if item.get('connected')),
        'sse_errors': [item.get('error') for item in sse_results if item.get('error')][:3],
        'p50_ms': percentile(durations, 0.50),
        'p95_ms': percentile(durations, 0.95),
        'max_ms': round(max(durations), 2) if durations else None,
        'estimated_p1_completions': sum(1 for item in results if item[0] == 200),
    }
    if CAPTURE_P1_ACK:
        summary.update({
            'p1_ack_samples': len(p1_ack_samples),
            'p1_ack_p50_ms': percentile(p1_ack_samples, 0.50),
            'p1_ack_p95_ms': percentile(p1_ack_samples, 0.95),
            'p1_ack_max_ms': round(max(p1_ack_samples), 2) if p1_ack_samples else None,
            'p1_status_errors': len(status_errors),
        })
    print(json.dumps(summary, ensure_ascii=False), flush=True)
    return summary


def run_sustained(duration_seconds, rounds, request_rate):
    seed()
    failed_rounds = 0
    for round_index in range(1, rounds + 1):
        summary = run_round(round_index, duration_seconds, request_rate)
        if summary['bad_count'] or summary['queue_drops'] or summary['sse_connected'] < 16:
            failed_rounds += 1
    print(json.dumps({'phase': 'sustained-complete', 'rounds': rounds, 'failed_rounds': failed_rounds}), flush=True)


def performance_request(range_name='6h', section=None):
    query = {'range': range_name}
    if section:
        query['section'] = section
    return request('GET', '/api/system/performance?' + urllib.parse.urlencode(query), timeout=30)


def health():
    status, body = request('GET', '/api/system/performance/health', timeout=10)
    print(json.dumps({'phase': 'telemetry-health', 'status': status, 'body': body}), flush=True)


def query():
    started = time.perf_counter()
    status, body = performance_request('30d')
    elapsed_ms = round((time.perf_counter() - started) * 1000, 2)
    try:
        payload = json.loads(body)
    except json.JSONDecodeError:
        payload = {'raw': body[:500]}
    series = payload.get('series', []) if isinstance(payload, dict) else []
    print(json.dumps({
        'phase': 'telemetry-query',
        'status': status,
        'elapsedMs': elapsed_ms,
        'from': payload.get('from') if isinstance(payload, dict) else None,
        'to': payload.get('to') if isinstance(payload, dict) else None,
        'stepSeconds': payload.get('stepSeconds') if isinstance(payload, dict) else None,
        'coverage': payload.get('coverage') if isinstance(payload, dict) else None,
        'seriesCount': len(series),
        'maxPoints': max((len(item.get('points', [])) for item in series), default=0),
        'raw': payload if status != 200 else None,
    }, ensure_ascii=False), flush=True)


def capacity_seed():
    paths = [name for name in os.listdir(DATA_DIR) if name.endswith('.performance.sqlite')]
    if len(paths) != 1:
        raise SystemExit(f'expected one performance database, found {paths}')
    database_path = os.path.join(DATA_DIR, paths[0])
    now = int(time.time())
    first_minute = (now - 30 * 24 * 60 * 60) // 60 * 60
    last_minute = now // 60 * 60
    metric_dimensions = [
        ('http.request.count', 'proxy', 50.0),
        ('http.request.duration_ms', 'proxy', 1200.0),
        ('proxy.request.duration_ms', 'proxy', 1200.0),
        ('proxy.upstream_attempt_duration_ms', 'upstream', 1100.0),
        ('p1.ack_duration_ms', 'p1', 8.0),
        ('p1.queue_depth', 'p1', 2.0),
        ('p1.queue_bytes', 'p1', 4096.0),
        ('p2.queue_depth', 'p2', 1.0),
        ('projection.last_good_age_ms', 'dashboard', 100.0),
        ('sse.active_subscribers', 'dashboard', 16.0),
        ('maintenance.backlog_age_ms', 'maintenance', 0.0),
        ('process.rss_bytes', 'process', 128 * 1024 * 1024),
        ('process.cpu_percent', 'process', 10.0),
        ('storage.main_db_bytes', 'main_db', 20 * 1024 * 1024),
        ('storage.telemetry_db_bytes', 'telemetry_db', 2 * 1024 * 1024),
        ('telemetry.queue_depth', 'collector', 1.0),
    ]
    histogram = '[0,0,0,0,0,0,0,1]'
    epoch = 'capacity-seed'
    connection = sqlite3.connect(database_path)
    connection.execute('PRAGMA journal_mode=WAL')
    connection.execute('BEGIN')
    rows = []
    for bucket in range(first_minute, last_minute, 60):
        for metric_id, dimension, value in metric_dimensions:
            is_duration = metric_id.endswith('_duration_ms') or metric_id == 'maintenance.run_duration_ms'
            count = 50 if metric_id == 'http.request.count' else 1
            rows.append((bucket, 60, metric_id, dimension, count, count, value * count, value, value, value, value * 10 if not is_duration else 0, 10 if not is_duration else 0, histogram, epoch))
        if len(rows) >= 10_000:
            connection.executemany('INSERT OR REPLACE INTO performance_buckets(bucket_start,resolution_seconds,metric_id,dimension_code,sample_count,expected_count,sum_value,min_value,max_value,last_value,weighted_sum,weighted_seconds,histogram_json,epoch) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)', rows)
            rows.clear()
    if rows:
        connection.executemany('INSERT OR REPLACE INTO performance_buckets(bucket_start,resolution_seconds,metric_id,dimension_code,sample_count,expected_count,sum_value,min_value,max_value,last_value,weighted_sum,weighted_seconds,histogram_json,epoch) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)', rows)
    connection.execute("INSERT OR REPLACE INTO performance_epochs(epoch, started_at) VALUES (?, datetime('now'))", (epoch,))
    connection.commit()
    connection.close()
    print(json.dumps({'phase': 'capacity-seed', 'minutes': (last_minute - first_minute) // 60, 'series': len(metric_dimensions), 'database': database_path}), flush=True)


def lock_db(seconds):
    paths = [name for name in os.listdir(DATA_DIR) if name.endswith('.performance.sqlite')]
    if len(paths) != 1:
        raise SystemExit(f'expected one performance database, found {paths}')
    database_path = os.path.join(DATA_DIR, paths[0])
    connection = sqlite3.connect(database_path, timeout=1, isolation_level=None)
    connection.execute('BEGIN EXCLUSIVE')
    print(json.dumps({'phase': 'lock-started', 'seconds': seconds}), flush=True)
    time.sleep(seconds)
    connection.rollback()
    connection.close()
    print(json.dumps({'phase': 'lock-released'}), flush=True)


def fault_probe(seconds):
    deadline = time.time() + seconds
    health_failures = 0
    while time.time() < deadline:
        status, body = request('GET', '/health', timeout=5)
        if status != 200 or body != 'ok':
            health_failures += 1
        request('POST', '/api/system/performance/browser', {
            'events': [{'page': 'system', 'device': 'desktop', 'metric': 'data_ready_ms', 'value': 12.0}],
        }, headers={'Origin': 'http://app:8080'}, timeout=5)
        time.sleep(1)
    print(json.dumps({'phase': 'fault-probe', 'seconds': seconds, 'health_failures': health_failures}), flush=True)


COMMANDS = {
    'wait-health': wait_health,
    'seed': seed,
    'sustained': lambda: run_sustained(int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])),
    'long-wait': lambda: run_long_wait(int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])),
    'health': health,
    'query': query,
    'capacity-seed': capacity_seed,
    'lock-db': lambda: lock_db(int(sys.argv[2])),
    'fault-probe': lambda: fault_probe(int(sys.argv[2])),
}

if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
    raise SystemExit(f'usage: {sys.argv[0]} <{">".join(sorted(COMMANDS))}> [args]')
COMMANDS[sys.argv[1]]()
PY
