import json
import pathlib
import statistics
import sys

samples = []
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    try:
        row = json.loads(line)
    except json.JSONDecodeError:
        continue
    cpu = row.get('CPUPerc', '').rstrip('%')
    mem = row.get('MemUsage', '').split('/')[0].strip()
    try:
        cpu_value = float(cpu)
    except ValueError:
        continue
    samples.append({'cpu_percent': cpu_value, 'memory': mem})
if not samples:
    raise SystemExit('no docker stats samples captured')
cpus = [sample['cpu_percent'] for sample in samples]
print(json.dumps({
    'phase': 'container-stats-summary',
    'samples': len(samples),
    'cpu_average_percent': round(statistics.mean(cpus), 2),
    'cpu_p95_percent': round(sorted(cpus)[min(len(cpus) - 1, int(len(cpus) * 0.95))], 2),
    'cpu_max_percent': round(max(cpus), 2),
