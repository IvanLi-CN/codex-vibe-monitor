# Include private token maps in the existing authenticated HTTPS entry.
# Each map file contains one quoted "Bearer <token>" value mapped to 1, mode 0640.
map $http_authorization $tempo_ingest_allowed {
    default 0;
    include /run/secrets/tempo-ingest-map;
}
map $http_authorization $tempo_query_allowed {
    default 0;
    include /run/secrets/tempo-query-map;
}
# Insert the following locations into the HTTPS server; never publish Tempo ports.
# The gateway must join the dedicated OBSERVABILITY_TEMPO_NETWORK with Tempo;
# Grafana/Prometheus and arbitrary monitoring-network peers must not join it.
# Tenant comes from the credential's assigned route, never a caller's header.
location = /v1/traces {
    if ($request_method != POST) { return 405; }
    if ($tempo_ingest_allowed != 1) { return 401; }
    client_max_body_size 1m;
    client_body_timeout 2s;
    proxy_connect_timeout 2s;
    proxy_read_timeout 2s;
    proxy_set_header Authorization "";
    proxy_set_header X-Scope-OrgID cvm;
    proxy_pass http://tempo:4318/v1/traces;
}
# Tempo 3.1 search responses may omit any number of leading zeroes in traceID values.
# Normalize every 1-32-character lowercase hexadecimal ID before the
# trace-by-ID lookup; a W3C trace ID is always exactly 32 hexadecimal characters.
location ~ ^/tempo/api/(search|v2/traces/[a-f0-9]{1,32})$ {
    if ($request_method != GET) { return 405; }
    if ($tempo_query_allowed != 1) { return 401; }
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    proxy_set_header Authorization "";
    proxy_set_header X-Scope-OrgID cvm;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{1})$" /api/v2/traces/0000000000000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{2})$" /api/v2/traces/000000000000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{3})$" /api/v2/traces/00000000000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{4})$" /api/v2/traces/0000000000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{5})$" /api/v2/traces/000000000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{6})$" /api/v2/traces/00000000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{7})$" /api/v2/traces/0000000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{8})$" /api/v2/traces/000000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{9})$" /api/v2/traces/00000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{10})$" /api/v2/traces/0000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{11})$" /api/v2/traces/000000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{12})$" /api/v2/traces/00000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{13})$" /api/v2/traces/0000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{14})$" /api/v2/traces/000000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{15})$" /api/v2/traces/00000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{16})$" /api/v2/traces/0000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{17})$" /api/v2/traces/000000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{18})$" /api/v2/traces/00000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{19})$" /api/v2/traces/0000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{20})$" /api/v2/traces/000000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{21})$" /api/v2/traces/00000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{22})$" /api/v2/traces/0000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{23})$" /api/v2/traces/000000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{24})$" /api/v2/traces/00000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{25})$" /api/v2/traces/0000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{26})$" /api/v2/traces/000000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{27})$" /api/v2/traces/00000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{28})$" /api/v2/traces/0000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{29})$" /api/v2/traces/000$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{30})$" /api/v2/traces/00$1 break;
    rewrite "^/tempo/api/v2/traces/([a-f0-9]{31})$" /api/v2/traces/0$1 break;
    rewrite ^/tempo/(.*)$ /$1 break;
    proxy_pass http://tempo:3200;
}
location /tempo/ { return 404; }
