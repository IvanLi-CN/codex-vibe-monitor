    {
      "id": 10,
      "type": "table",
      "title": "上报质量分类",
      "description": "accepted/rejected 是批次，dropped/unsupported 是客户端事件分类；不能把批次数与事件数相加，也不能推断访问量覆盖率。",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome,reason) (increase(cvm_browser_ingest_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",outcome=\"accepted\"}[$__range]))",
          "legendFormat": "accepted 批次",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "B",
          "expr": "sum by (outcome,reason) (increase(cvm_browser_ingest_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",outcome=\"rejected\"}[$__range]))",
          "legendFormat": "rejected 批次",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "C",
          "expr": "sum by (page) (increase(cvm_browser_dropped_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))",
          "legendFormat": "client dropped",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "D",
          "expr": "sum by (page) (increase(cvm_browser_unsupported_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))",
