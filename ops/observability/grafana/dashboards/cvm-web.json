    {
      "id": 4,
      "type": "stat",
      "title": "长任务次数 / 分钟",
      "description": "被接受上报的 long_task 事件速率；不是全站访问量，样本数按事件计。",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(cvm_browser_events_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",event=\"long_task\"}[$__rate_interval])) * 60",
          "legendFormat": "次数 / 分钟",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        },
        {
          "refId": "B",
          "expr": "sum by (page) (increase(cvm_browser_events_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",event=\"long_task\"}[$__range]))",
          "legendFormat": "样本数",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "无样本",
          "decimals": 2
