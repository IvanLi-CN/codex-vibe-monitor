      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase(cvm_proxy_retries_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",endpoint=~\"$endpoint\"}[$__range]))",
          "legendFormat": "重试",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "无样本",
