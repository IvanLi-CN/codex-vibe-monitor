    {
      "id": 7,
      "type": "timeseries",
      "title": "TTFB / TTFT p95 趋势",
      "description": "TTFB 是上游首字节，TTFT 是首 token；两者都来自代理终态样本。",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cvm_proxy_ttfb_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "TTFB p95",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cvm_proxy_ttft_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "TTFT p95",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "无样本",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
