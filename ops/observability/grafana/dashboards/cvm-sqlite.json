    {
      "id": 10,
      "type": "table",
      "title": "SQL 排名（默认累计采样耗时）",
      "description": "只覆盖已导出的规范化模板，最多 10 项；完整模板不挤在图例。表格查询整个所选窗口，可按次数或 p95 调整排序。函数/SQL 时序使用 hotpath native Histogram。",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_count(sum by (query) (increase(hotpath_sql_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))))",
          "legendFormat": "样本数",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "B",
          "expr": "topk(10, histogram_sum(sum by (query) (increase(hotpath_sql_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))))",
          "legendFormat": "累计采样耗时",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "C",
          "expr": "topk(10, histogram_sum(sum by (query) (increase(hotpath_sql_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range])))) / clamp_min(histogram_count(sum by (query) (increase(hotpath_sql_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))), 1)",
          "legendFormat": "平均耗时",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "D",
          "expr": "topk(10, histogram_quantile(0.95, sum by (query) (increase(hotpath_sql_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))))",
          "legendFormat": "p95",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "E",
          "expr": "topk(10, increase(hotpath_sql_queries_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))",
          "legendFormat": "窗口次数",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无样本",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "links": []
        },
        "overrides": [],
        "sortBy": [
          {
            "displayName": "累计采样耗时",
            "desc": true
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "累计采样耗时",
            "desc": true
          }
        ]
      }
    },
