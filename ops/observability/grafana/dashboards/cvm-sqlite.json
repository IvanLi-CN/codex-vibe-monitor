    {
      "id": 7,
      "type": "bargauge",
      "title": "池 / 队列 / 执行阶段 p95",
      "description": "pool acquire、queue wait、batch execute、ACK、enqueue-to-commit 可能重叠；这里只做横向比较，禁止堆叠或相加。",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cvm_sqlite_pool_acquire_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "pool acquire",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,class) (rate(cvm_sqlite_queue_wait_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "queue wait / {{class}}",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le,class) (rate(cvm_sqlite_batch_execute_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "batch execute / {{class}}",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le,class) (rate(cvm_sqlite_batch_ack_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "ACK / {{class}}",
