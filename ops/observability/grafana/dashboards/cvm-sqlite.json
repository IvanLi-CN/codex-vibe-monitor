  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "准入等待 p95",
      "description": "四类 coordinator wait 合并后计算 p95；不代表完整请求耗时。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cvm_sqlite_coordinator_wait_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "准入 wait p95",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "无样本",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
