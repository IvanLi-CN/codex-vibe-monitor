    {
      "id": 13,
      "type": "stat",
      "title": "DB / WAL 大小",
      "description": "主库文件和 WAL metadata 读数；文件采样过期时单独看新鲜度。",
      "gridPos": {
        "x": 18,
        "y": 46,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cvm_storage_database_bytes{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",database=\"main\"})",
          "legendFormat": "数据库",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        },
        {
          "refId": "B",
          "expr": "sum(cvm_sqlite_wal_bytes{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",database=\"main\"})",
