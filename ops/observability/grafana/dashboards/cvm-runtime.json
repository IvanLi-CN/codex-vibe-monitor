      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,task_key)(rate(cvm_task_run_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",task_key=~\"$task_key\"}[$__rate_interval])))",
