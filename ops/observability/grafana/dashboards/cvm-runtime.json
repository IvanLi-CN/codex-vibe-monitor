  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU（核）",
      "description": "相对单核 CPU 使用，包含 user + system；函数计时不能替代 CPU 成本。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cvm_process_cpu_seconds_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "CPU",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "cyan"
          },
          "noValue": "Unknown",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
