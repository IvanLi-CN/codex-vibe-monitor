    {
      "id": 8,
      "type": "table",
      "title": "函数耗时（native，10% 计时抽样）",
      "description": "名称、总调用数、计时样本数、平均耗时、p95、累计采样耗时。计时包含等待，不能称 CPU 排名；累计采样耗时不能冒充全量成本。",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, increase(hotpath_function_calls_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))",
          "legendFormat": "总调用数",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "B",
          "expr": "topk(20, histogram_count(sum by (function) (increase(hotpath_function_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))))",
          "legendFormat": "计时样本数",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "C",
          "expr": "topk(20, histogram_sum(sum by (function) (increase(hotpath_function_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))) / clamp_min(histogram_count(sum by (function) (increase(hotpath_function_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))), 1))",
          "legendFormat": "平均耗时",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "D",
          "expr": "topk(20, histogram_quantile(0.95, sum by (function) (increase(hotpath_function_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))))",
          "legendFormat": "p95",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "E",
          "expr": "topk(20, histogram_sum(sum by (function) (increase(hotpath_function_duration_seconds{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range]))))",
          "legendFormat": "累计采样耗时",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "links": []
        },
        "overrides": [],
        "sortBy": [
          {
            "displayName": "累计采样耗时",
            "desc": true
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "累计采样耗时",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "任务结果与耗时",
      "description": "task_key 来自任务注册表；保留任务详情深链接。按真实 outcome 展示 success、error、skipped、deferred 等状态，窗口查询使用 increase，耗时 p95 与样本数来自独立 Histogram。",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cvm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_key,outcome) (increase(cvm_task_runs_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",task_key=~\"$task_key\"}[$__range]))",
          "legendFormat": "{{task_key}} / {{outcome}}",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,task_key) (increase(cvm_task_run_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[$__range])))",
          "legendFormat": "{{task_key}} p95",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        },
        {
          "refId": "C",
          "expr": "sum by (task_key) (increase(cvm_task_run_duration_seconds_count{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",task_key=~\"$task_key\"}[$__range]))",
          "legendFormat": "{{task_key}} 样本数",
          "range": false,
          "instant": true,
          "format": "table",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "links": [
            {
              "title": "打开任务详情",
              "url": "/d/cvm-runtime?var-service=${__data.fields.service}&var-environment=${__data.fields.environment}&var-instance=${__data.fields.instance}&var-task_key=${__data.fields.task_key}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": [],
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "选定锁等待 p95",
      "description": "hotpath native lock wait；标签是 label/source/iter，不假设为 SQLite class。",
      "gridPos": {
        "x": 0,
        "y": 46,
