          "legendFormat": "失败",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        },
        {
          "refId": "C",
          "expr": "sum (rate(cvm_proxy_invocations_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",endpoint=~\"$endpoint\",outcome=\"cancelled\"}[$__rate_interval])) * 60",
          "legendFormat": "取消",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        }
