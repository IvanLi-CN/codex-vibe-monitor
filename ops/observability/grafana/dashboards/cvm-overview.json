      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(cvm_proxy_invocations_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",endpoint=~\"$endpoint\",outcome=\"success\"}[$__rate_interval])) * 60",
          "legendFormat": "成功",
          "range": true,
          "instant": false,
          "format": "time_series",
          "hide": false
        },
        {
          "refId": "B",
