            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "取消"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
