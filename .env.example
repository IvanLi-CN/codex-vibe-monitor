# Compose project and image settings.
COMPOSE_PROJECT_NAME=cvm-analytics
CVM_IMAGE=codex-vibe-monitor:analytics-local
CVM_HTTP_PORT=8080
POSTGRES_IMAGE=postgres:18-bookworm

# Select exactly one Compose profile: sqlite or postgres.
# SQLite is the default application backend and does not require PostgreSQL inputs.
ANALYTICS_BACKEND=sqlite
POSTGRES_MAX_CONNECTIONS=5

# Keep these volume names stable across restarts and backend mode changes.
CVM_DATA_VOLUME=cvm_analytics_data
POSTGRES_DATA_VOLUME=cvm_analytics_postgres
POSTGRES_DB=cvm_analytics
POSTGRES_SUPERUSER=postgres
POSTGRES_MIGRATION_USER=cvm_analytics_migration

# Secret files are local-only and must not be committed. Each DSN file contains one
# complete URL, including its role and password, for the postgres Compose network.
POSTGRES_MIGRATION_URL_FILE=.secrets/postgres-migration-url
POSTGRES_DATABASE_URL_FILE=.secrets/postgres-database-url
POSTGRES_ANALYTICS_MAINTENANCE_URL_FILE=.secrets/postgres-analytics-maintenance-url
POSTGRES_SUPERUSER_PASSWORD_FILE=.secrets/postgres-superuser-password
POSTGRES_MIGRATION_PASSWORD_FILE=.secrets/postgres-migration-password
POSTGRES_APP_PASSWORD_FILE=.secrets/postgres-app-password
POSTGRES_MAINTENANCE_PASSWORD_FILE=.secrets/postgres-maintenance-password
